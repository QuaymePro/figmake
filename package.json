{
  "name": "figmake",
  "version": "3.0.0",
  "description": "Design-to-code compiler with AI agent guardrails. Extract Figma designs as pixel-perfect React code with enforced design tokens.",
  "keywords": [
    "figma",
    "react",
    "design-to-code",
    "design-tokens",
    "ai-coding",
    "vibecoding",
    "cursor",
    "claude"
  ],
  "license": "MIT",
  "repository": "github.com/QuaymePro/figmake",
  "main": "dist/plugin/code.js",
  "bin": {
    "figmake": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run build:plugin && npm run build:cli",
    "build:plugin": "esbuild src/plugin/code.ts --bundle --outfile=dist/plugin/code.js && cp src/plugin/ui.html dist/plugin/ui.html",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --outfile=dist/cli/index.js",
    "test": "vitest",
    "lint": "eslint src/",
    "dev": "concurrently \"npm run build:plugin -- --watch\" \"npm run build:cli -- --watch\""
  },
  "dependencies": {
    "@types/pixelmatch": "^5.2.6",
    "axios": "^1.6.7",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0",
    "pixelmatch": "^7.2.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.83.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
